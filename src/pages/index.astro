        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="https://wa.me/34638717215?text=Hola%20SODAGRO%2C%20quiero%20pedir%20presupuesto%20para%20mi%20finca"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 bg-[#25D366] hover:bg-[#20ba59] text-white font-bold text-base px-8 py-4 rounded-xl shadow-lg transition-transform hover:scale-105 active:scale-95"
          >
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7.02 8.48 7.02 9.68C7.02 10.88 7.9 12.04 8.02 12.2C8.14 12.37 9.73 14.83 12.16 15.88C14.19 16.75 14.6 16.58 15.04 16.54C15.48 16.5 16.46 15.96 16.66 15.39C16.86 14.81 16.86 14.32 16.8 14.21C16.74 14.11 16.58 14.05 16.34 13.93C16.1 13.81 14.92 13.23 14.7 13.15C14.48 13.07 14.32 13.03 14.16 13.28C14 13.52 13.54 14.11 13.4 14.27C13.26 14.44 13.12 14.46 12.88 14.34C12.64 14.21 11.87 13.96 10.95 13.14C10.24 12.5 9.76 11.72 9.62 11.48C9.48 11.24 9.6 11.11 9.73 10.98C9.84 10.87 9.98 10.69 10.1 10.55C10.22 10.41 10.26 10.31 10.34 10.15C10.42 9.99 10.38 9.84 10.32 9.72C10.26 9.6 9.79 8.44 9.59 7.96C9.4 7.5 9.2 7.56 9.05 7.55C8.91 7.55 8.74 7.33 8.53 7.33Z"/>
            </svg>
            <span>Escribir por WhatsApp</span>
