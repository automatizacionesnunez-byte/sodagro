<div class="relative">
<div class="hidden lg:block absolute top-1/2 left-0 right-0 h-1 bg-surface-container-high -translate-y-8 z-0"></div>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-6 relative z-10">
