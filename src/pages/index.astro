<script>
  (function initFaq() {
    const triggers = document.querySelectorAll('.faq-trigger');
    triggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
        const content = trigger.nextElementSibling;
        const icon = trigger.querySelector('.material-symbols-outlined');

        // Close all others
        triggers.forEach(otherTrigger => {
          if (otherTrigger !== trigger) {
            otherTrigger.setAttribute('aria-expanded', 'false');
            otherTrigger.nextElementSibling.classList.add('hidden');
            const otherIcon = otherTrigger.querySelector('.material-symbols-outlined');
            if (otherIcon) otherIcon.classList.remove('rotate-180');
          }
        });

        // Toggle clicked
        if (isExpanded) {
          trigger.setAttribute('aria-expanded', 'false');
          content.classList.add('hidden');
          if (icon) icon.classList.remove('rotate-180');
        } else {
          trigger.setAttribute('aria-expanded', 'true');
          content.classList.remove('hidden');
          if (icon) icon.classList.add('rotate-180');
        }
      });
    });
  })();
</script></main><a aria-label="Contactar por WhatsApp" class="fixed bottom-6 right-6 z-50 inline-flex items-center gap-2.5 bg-primary hover:bg-secondary text-on-primary px-4 py-3 rounded-full shadow-[0_8px_24px_rgba(37,43,38,0.16)] transition-all group" href="https://wa.me/34638717215" rel="noopener noreferrer" target="_blank"><span class="material-symbols-outlined text-2xl">chat</span><span class="font-label-lg text-label-lg hidden sm:inline group-hover:inline transition-all">WhatsApp directo</span></a>
