---
import Layout from "../layouts/Layout.astro";

const seo = {
  title: "SODAGRO | Servicios Agrícolas, Maquinaria Propia y Vivero Oficial en Andalucía",
  description: "Servicios agrícolas integrales y vivero oficial en Andalucía: recolección con paraguas, poda, tratamientos, nuevas plantaciones llave en mano y gestión PAC. Presupuesto en 24h.",
  canonical: "https://sodagro.es/"
};

const faqBlocks = [
  {
    title: "1. Gestión Integral de Fincas y PAC",
    description: "Propietarios no residentes, herederos y tramitaciones normativas sin penalización.",
    items: [
      {
        q: "Si hay una inspección o penalización de la Junta de Andalucía por la PAC o el e-cuaderno, ¿quién responde?",
        a: "El titular de la explotación es el responsable legal de la veracidad de los datos. En SODAGRO actuamos como tu representante técnico autorizado: entregamos y registramos cada labor y tratamiento fitosanitario en plazo normativo, mantenemos la documentación al día y te defendemos presencialmente en inspecciones y alegaciones."
      },
      {
        q: "Vivo fuera y la finca es de herederos o comunidad de bienes: ¿cómo controlo costes y cosecha?",
        a: "Con total trazabilidad y control previo: trabajamos con presupuestos aprobados, partes de maquinaria diarios, fotografías de cada labor e informes periódicos. Al terminar la campaña, la liquidación de la cooperativa o almazara se concilia al céntimo con los gastos reales."
      },
      {
        q: "¿Cómo solicito una visita o estudio agronómico inicial sin compromiso?",
        a: "Indícanos por WhatsApp o teléfono tu municipio, cultivo y superficie. Un ingeniero agrónomo de SODAGRO acude a la finca, revisa el estado del cultivo y te entrega un diagnóstico con propuesta técnica y presupuesto cerrado, sin ningún compromiso."
      }
    ]
  },
  {
    title: "2. Contratación, Tarifas y Ámbito Operativo",
    description: "Formas de cobro, fincas pequeñas, seguros y desplazamiento en Andalucía.",
    items: [
      {
        q: "¿Cobráis por hectárea, por hora o por kilo de aceituna recogida?",
        a: "Presupuestamos a medida tras valorar la finca sobre el terreno: habitualmente por horas con mínimo de jornada para labores mecanizadas, o a precio cerrado por hectárea en parcelas homogéneas. El presupuesto desglosa máquina, tractorista, cuadrilla, transporte y repaso."
      },
      {
        q: "¿En qué zonas y comarcas de Andalucía tenéis disponibilidad y desplazáis maquinaria?",
        a: "Nuestra base operativa y parque de maquinaria están en Cabra (Córdoba). Trabajamos habitualmente en toda la provincia de Córdoba (Campiña y Subbética: Lucena, Baena, Montilla, Priego), Jaén, Sevilla, norte de Málaga y Granada, desplazando equipos propios a pie de parcela."
      },
      {
        q: "¿Trabajáis fincas pequeñas de pocas hectáreas o cobráis un desplazamiento excesivo?",
        a: "Sí trabajamos parcelas pequeñas. Para que la labor te resulte rentable, coordinamos fincas cercanas de la misma comarca y acordamos una tarifa de salida o desplazamiento fija antes de arrancar, sin ningún sobrecoste sorpresa."
      },
      {
        q: "¿Qué ocurre si hay daños en los árboles o un trabajo no queda bien ejecutado?",
        a: "Pactamos por escrito el alcance y los criterios de calidad antes de iniciar el trabajo. Realizamos un acta previa del estado de la plantación y contamos con seguro de responsabilidad civil para cualquier contingencia."
      }
    ]
  },
  {
    title: "3. Recolección Mecanizada y Maquinaria",
    description: "Vibrador con paraguas invertido, olivar tradicional, pendientes y labores sueltas.",
    items: [
      {
        q: "¿El paraguas vibrador invertido puede dañar la corteza o el tronco de mis olivos?",
        a: "No. Adaptamos la presión de la pinza, los tacos protectores y el tiempo de vibración al diámetro y edad del árbol. Además, revisamos previamente los troncos y descartamos vibrar olivos viejos con daños, huecos o patologías visibles."
      },
      {
        q: "¿Se puede meter el paraguas en olivar tradicional, de varios pies o en pendientes?",
        a: "Depende del marco y la accesibilidad de la parcela. En olivos de varios pies valoramos en campo si conviene paraguas o vibrador con mantones. En pendiente trabajamos siempre a favor del terreno, priorizando la estabilidad y la seguridad del operario."
      },
      {
        q: "¿Puedo contrataros solo para una labor suelta (como la recolección o la poda) sin contrato anual?",
        a: "Sí. No estás obligado a contratar la gestión anual. La mayoría de agricultores nos contratan para labores puntuales de campaña: recolección con paraguas, poda, tratamientos fitosanitarios o desbroce según sus necesidades de calendario."
      },
      {
        q: "¿Trabajáis únicamente olivar o también recolectáis y gestionáis almendro y pistacho?",
        a: "Trabajamos los tres cultivos leñosos principales. Nuestros vibradores y paraguas están preparados tanto para aceituna de molino y verdeo como para almendra y pistacho, ajustando las lonas y las frecuencias de vibración a cada especie."
      }
    ]
  },
  {
    title: "4. Vivero Oficial, Calendario y Plantaciones Llave en Mano",
    description: "Plantones certificados, variedades adaptadas, guiado GPS RTK y garantía de arraigo.",
    items: [
      {
        q: "¿Los plantones tienen pasaporte fitosanitario oficial y garantías frente a Xylella?",
        a: "Sí. Somos vivero oficial inscrito en el ROPVEG. Todos los lotes se entregan con factura, etiqueta identificativa clonal y pasaporte fitosanitario oficial de la Junta de Andalucía, certificados libres de Xylella fastidiosa y verticilosis."
      },
      {
        q: "¿Qué variedad me recomendáis para mi zona: secano o regadío?",
        a: "Te asesoramos según suelo, pluviometría y marco: en regadío destacan Picual y Arbequina por su rápida entrada en producción y rendimiento graso; en secano andaluz, la Hojiblanca ofrece una rusticidad y adaptación excepcionales."
      },
      {
        q: "¿Qué incluye la plantación «llave en mano» con GPS RTK y qué garantía de arraigo dais?",
        a: "Incluye estudio agronómico, preparación del suelo, replanteo y marcado milimétrico por GPS RTK, suministro de planta certificada, tutores, protectores y primer riego. La garantía de arraigo y reposición de marras se estipula por contrato por escrito."
      },
      {
        q: "¿Con cuánta antelación conviene reservar la campaña de recolección o la planta de vivero?",
        a: "Para recolección mecanizada recomendamos cerrar fechas 3 o 4 semanas antes del inicio de campaña para garantizar disponibilidad de máquina. Para nuevas plantaciones de vivero, conviene reservar los plantones con 2 a 3 meses de antelación para asegurar lote y variedad."
      }
    ]
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqBlocks.flatMap((block) =>
    block.items.map((item) => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.a
      }
    }))
  )
};
---

