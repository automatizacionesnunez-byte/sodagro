            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 text-white font-semibold text-base px-6 py-4 rounded-xl border border-white/20 transition-all"
          >
            <span class="material-symbols-outlined text-xl">phone</span>
            <span>+34 638 71 72 15</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 5. PREGUNTAS FRECUENTES CLAVE (Solo las 3 esenciales) -->
    <section class="max-w-3xl mx-auto px-6 pb-20">
      <div class="text-center space-y-2 mb-8">
        <h2 class="text-2xl font-bold text-[#0a3621]">Dudas habituales</h2>
        <p class="text-xs text-neutral-600">Lo que todo agricultor quiere saber antes de llamarnos.</p>
      </div>

      <div class="space-y-3">
        <div class="p-4 rounded-xl bg-white border border-neutral-200">
          <h3 class="font-bold text-sm text-[#0a3621]">¿En qué zonas prestáis servicio?</h3>
          <p class="text-xs text-neutral-600 mt-1 leading-relaxed">
            Nuestra base operativa está en Cabra (Córdoba). Trabajamos habitualmente en toda la provincia de Córdoba, Jaén, Sevilla, Granada y Málaga, desplazando maquinaria y cuadrillas propias a pie de finca.
          </p>
