  <main class="w-full bg-[#f9faf8] text-[#1b2f23]">
    <!-- 1. HERO TRANSPARENTE: COLORES NATURALES DEL CAMPO Y MÁXIMA CONVERSIÓN -->
    <section class="relative w-full overflow-hidden text-white pt-28 pb-16 lg:pt-36 lg:pb-24 min-h-[580px] lg:min-h-[640px] flex items-center">
