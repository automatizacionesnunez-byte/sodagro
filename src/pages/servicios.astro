<div class="bg-surface-container-lowest/5 backdrop-blur-sm p-4 rounded-xl">
<div class="font-headline-lg text-headline-lg text-tertiary-fixed leading-none">&gt;20</div>
<p class="font-label-md text-label-md text-surface-container-low mt-1">Equipos propios de campo</p>
</div>
<div class="bg-surface-container-lowest/5 backdrop-blur-sm p-4 rounded-xl">
<div class="font-headline-lg text-headline-lg text-secondary-fixed leading-none">24h</div>
<p class="font-label-md text-label-md text-surface-container-low mt-1">Respuesta técnica in situ</p>
</div>
<div class="bg-surface-container-lowest/5 backdrop-blur-sm p-4 rounded-xl">
<div class="font-headline-lg text-headline-lg text-tertiary-fixed leading-none">360°</div>
<p class="font-label-md text-label-md text-surface-container-low mt-1">Gestión integral de cultivo</p>
</div>
</div>
</div>
</section>
<!-- INTERACTIVE AREA FILTER TABS -->
<section class="sticky top-20 z-40 bg-surface-container-lowest shadow-sm">
<div class="max-w-7xl mx-auto px-6 lg:px-12 py-3 overflow-x-auto no-scrollbar">
<div class="flex items-center gap-2 min-w-max" id="service-filters" role="tablist">
<button class="filter-tab active-tab px-4 py-2 rounded-lg font-label-md text-label-md transition-all bg-primary-container text-on-primary" data-filter="all" type="button">
