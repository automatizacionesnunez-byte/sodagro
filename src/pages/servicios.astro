<script>
  // Tab filtering logic
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
    const serviceBlocks = document.querySelectorAll<HTMLElement>('.service-block');

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.getAttribute('data-filter');

        // Style updates
        filterButtons.forEach((btn) => {
          btn.classList.remove('bg-primary-container', 'text-on-primary');
          btn.classList.add('bg-surface-container', 'text-on-surface-variant');
        });
        button.classList.remove('bg-surface-container', 'text-on-surface-variant');
        button.classList.add('bg-primary-container', 'text-on-primary');

        // Block display toggle
        serviceBlocks.forEach((block) => {
          const area = block.getAttribute('data-area');
          if (filter === 'all' || filter === area) {
            block.style.display = 'flex';
          } else {
            block.style.display = 'none';
          }
        });

        // Smooth scroll to top of services if clicked on a specific area
        if (filter !== 'all') {
          const target = document.getElementById(`sec-${filter}`);
          if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    });
  });
</script></main>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const servForm = document.getElementById('form-presupuesto') as HTMLFormElement | null;
    if (servForm) {
      servForm.addEventListener('submit', (e) => {
        e.preventDefault();

        const fd = new FormData(servForm);
        const nombre = fd.get('nombre')?.toString().trim() || 'No indicado';
        const telefono = fd.get('telefono')?.toString().trim() || '';
        const municipio = fd.get('municipio')?.toString().trim() || 'No indicado';
        const hectareas = fd.get('hectareas')?.toString().trim() || '';
        const mensaje = fd.get('mensaje')?.toString().trim() || '';

        const checkboxes = servForm.querySelectorAll<HTMLInputElement>('input[name="servicios"]:checked');
        const selectedServices: string[] = [];
        const labelsMap: Record<string, string> = {
          pac: 'Gestión PAC y Ayudas',
          plantaciones: 'Vivero y Plantación',
          mantenimiento: 'Laboreo y Mantenimiento',
          sanidad: 'Tratamientos y Sanidad',
          recoleccion: 'Campaña de Recolección',
          integral: 'Gestión Integral 360°'
        };
        checkboxes.forEach((cb) => {
          selectedServices.push(labelsMap[cb.value] || cb.value);
        });

        let text = '🚜 *SOLICITUD DE PRESUPUESTO — SODAGRO*\n';
        text += '━━━━━━━━━━━━━━━━━━━━━━\n';
        text += '👤 *Nombre:* ' + nombre + '\n';
        text += '📞 *Teléfono:* +34 ' + telefono + '\n';
        text += '📍 *Municipio / Zona:* ' + municipio + '\n';
        if (hectareas) {
          text += '📐 *Superficie:* ' + hectareas + ' ha\n';
        }
        if (selectedServices.length > 0) {
          text += '🛠️ *Servicios de interés:*\n';
          selectedServices.forEach((s) => {
            text += '  • ' + s + '\n';
          });
        }
        if (mensaje) {
          text += '\n💬 *Detalles de la finca:*\n"' + mensaje + '"\n';
        }
        text += '━━━━━━━━━━━━━━━━━━━━━━\n';
        text += '_Enviado desde sodagro.es/servicios_';

        const encoded = encodeURIComponent(text);
        const whatsappUrl = 'https://wa.me/34638717215?text=' + encoded;

        const status = document.getElementById('form-status');
        const link = document.getElementById('servicesWhatsappLink') as HTMLAnchorElement | null;
        if (status) status.classList.remove('hidden');
        if (link) link.href = whatsappUrl;

        window.open(whatsappUrl, '_blank');
      });
    }
  });
</script>

