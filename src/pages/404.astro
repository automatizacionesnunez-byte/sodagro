---
import Layout from "../layouts/Layout.astro";
const meta = { title: "404 — Página no encontrada", description: "La página solicitada no existe o ha sido movida." };
---

<Layout title={meta.title} description={meta.description}>
  <section class="mx-auto max-w-[var(--max-width)] px-6 py-24 text-center">
    <h1 class="font-[var(--font-display)] text-6xl font-bold text-[var(--color-text)]">404</h1>
    <p class="mt-4 text-lg text-[var(--color-text-muted)]">{meta.description}</p>
    <a href="/" class="mt-8 inline-block rounded-full bg-[var(--color-primary)] px-6 py-3 font-medium text-white">Volver al inicio</a>
  </section>
</Layout>