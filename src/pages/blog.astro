---
import Layout from "../layouts/Layout.astro";
import BlogPreview from "../components/BlogPreview.astro";
---

<Layout
  title="Blog — [Nombre de la empresa]"
  description="Ideas, análisis y mejores prácticas sobre nuestro sector."
  canonical="https://example.com/blog"
>
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-[var(--max-width)] px-6">
      <h1 class="font-[var(--font-display)] text-3xl font-bold tracking-tight text-[var(--color-text)] sm:text-4xl">
        Blog
      </h1>
      <BlogPreview />
    </div>
  </section>
</Layout>