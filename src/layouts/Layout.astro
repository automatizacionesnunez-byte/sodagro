---
import Head from "./Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
}

const { title, description, ogImage, canonical } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <Head
      title={title}
      description={description}
      ogImage={ogImage}
      canonical={canonical}
    />
  </head>
  <body class="bg-surface font-body-md text-on-surface antialiased selection:bg-secondary-container selection:text-on-secondary-container">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:text-on-primary shadow-lg"
    >
      Saltar al contenido principal
    </a>
    <Header />
    <slot />
    <Footer />
  </body>
</html>