---
import Head from "./Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
}

const { title, description, ogImage, canonical } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <Head
      title={title}
      description={description}
      ogImage={ogImage}
      canonical={canonical}
    />
  </head>
  <body class="bg-surface font-body-md text-on-surface antialiased selection:bg-secondary-container selection:text-on-secondary-container">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:text-on-primary shadow-lg"
    >
      Saltar al contenido principal
    </a>
    <Header />
    <slot />
    <Footer />

    <!-- Botón Flotante WhatsApp Oficial Simplificado -->
    <a
      href="https://wa.me/34638717215"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Contactar por WhatsApp con SODAGRO"
      class="fixed bottom-6 right-6 z-50 flex items-center justify-center w-14 h-14 bg-[#25D366] hover:bg-[#20ba5a] text-white rounded-full shadow-[0_4px_16px_rgba(37,211,102,0.45)] hover:shadow-[0_8px_24px_rgba(37,211,102,0.6)] hover:scale-110 active:scale-95 transition-all duration-300"
    >
