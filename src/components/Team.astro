---
const team = [
  { name: "[Nombre]", role: "[Cargo]", bio: "[Breve biografía]", image: "/images/team-1.webp" },
  { name: "[Nombre]", role: "[Cargo]", bio: "[Breve biografía]", image: "/images/team-2.webp" },
  { name: "[Nombre]", role: "[Cargo]", bio: "[Breve biografía]", image: "/images/team-3.webp" },
];
---

<section class="py-16 md:py-24">
  <div class="mx-auto max-w-[var(--max-width)] px-6">
    <div class="mx-auto max-w-2xl">
      <h2 class="font-[var(--font-display)] text-3xl font-bold tracking-tight text-[var(--color-text)]">
        Nuestro equipo
      </h2>
    </div>
    <div class="bento-grid mt-16">
      {team.map((member, index) => {
        const spans = [
          "col-span-12 md:col-span-4",
          "col-span-12 md:col-span-4",
          "col-span-12 md:col-span-4",
        ];
        return (
          <article
            class={`${spans[index]} spotlight-card rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-8 transition-all`}
          >
            <img
              src={member.image}
              alt={`Retrato de ${member.name}`}
              width="700"
              height="700"
              loading="lazy"
              decoding="async"
              class="mx-auto h-20 w-20 rounded-full object-cover"
            />
            <h3 class="mt-4 font-[var(--font-display)] text-lg font-bold text-[var(--color-text)] text-center">{member.name}</h3>
            <p class="mt-1 text-center text-sm text-[var(--color-primary)]">{member.role}</p>
            <p class="mt-3 text-center text-[var(--color-text-muted)]">{member.bio}</p>
          </article>
        );
      })}
    </div>
  </div>
</section>
