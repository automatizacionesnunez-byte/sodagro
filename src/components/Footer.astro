---
---

<footer class="w-full bg-[#1b2f23] text-[#d6dcd4] border-t border-[#244d36]/40">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 pt-16 pb-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12">
      <!-- Columna 1: Identidad y Lema Oficial -->
      <div class="space-y-4">
        <a href="/" class="inline-block hover:opacity-90 transition-opacity" aria-label="SODAGRO - Soluciones y Desarrollos Agrícolas">
          <img
            alt="SODAGRO - Soluciones y Desarrollos Agrícolas"
            class="h-11 w-auto object-contain"
            src="/assets/logo-sodagro-white.png"
          />
        </a>
        <p class="font-semibold text-xs text-[#ffdcbc] tracking-wider uppercase">
          De la tierra a la cosecha
        </p>
        <p class="text-sm text-[#dee4dc]/80 leading-relaxed">
          Soluciones y Desarrollos Agrícolas. Ingeniería agronómica, maquinaria especializada y gestión técnica 360° para fincas de olivar, almendro y cultivos del sur peninsular.
        </p>
      </div>

      <!-- Columna 2: Áreas de Servicio -->
      <div class="space-y-4">
        <h3 class="font-bold text-base text-white tracking-tight">Áreas de Servicio</h3>
        <ul class="space-y-2.5 text-sm text-[#dee4dc]/80">
          <li><a href="/servicios#gestion-pac" class="hover:text-white transition-colors">Gestión Agraria y PAC</a></li>
          <li><a href="/vivero" class="hover:text-white transition-colors font-medium text-[#beecb0]">Viveros y Plantaciones (Oficial)</a></li>
          <li><a href="/servicios#trabajos-mantenimiento" class="hover:text-white transition-colors">Trabajos y Mantenimiento</a></li>
          <li><a href="/servicios#fertilizacion-sanidad" class="hover:text-white transition-colors">Fertilización y Sanidad</a></li>
          <li><a href="/servicios#recoleccion-maquinaria" class="hover:text-white transition-colors">Recolección y Maquinaria</a></li>
          <li><a href="/servicios#gestion-integral" class="hover:text-white transition-colors font-semibold text-[#beecb0]">Gestión Integral 360°</a></li>
        </ul>
      </div>

      <!-- Columna 3: Enlaces Corporativos -->
      <div class="space-y-4">
        <h3 class="font-bold text-base text-white tracking-tight">Empresa</h3>
        <ul class="space-y-2.5 text-sm text-[#dee4dc]/80">
          <li><a href="/" class="hover:text-white transition-colors">Inicio</a></li>
          <li><a href="/servicios" class="hover:text-white transition-colors">Catálogo de Servicios</a></li>
          <li><a href="/vivero" class="hover:text-white transition-colors">Vivero SODAGRO</a></li>
          <li><a href="/sobre" class="hover:text-white transition-colors">Sobre Nosotros</a></li>
          <li><a href="/contacto" class="hover:text-white transition-colors">Contacto y Presupuestos</a></li>
        </ul>
      </div>

      <!-- Columna 4: Sede y Contacto Directo -->
      <div class="space-y-4">
        <h3 class="font-bold text-base text-white tracking-tight">Sede y Contacto</h3>
        <div class="space-y-3 text-sm text-[#dee4dc]/80">
          <p class="flex items-start gap-2.5">
            <span class="material-symbols-outlined text-lg text-[#ffdcbc] shrink-0">location_on</span>
            <span>Huerta Vado del Mor 131, 14940 Cabra (Córdoba), España</span>
          </p>
          <p class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-lg text-[#ffdcbc] shrink-0">call</span>
            <a href="tel:+34638717215" class="hover:text-white font-medium text-white transition-colors">
              +34 638 71 72 15
            </a>
          </p>
          <p class="flex items-start gap-2.5">
            <span class="material-symbols-outlined text-lg text-[#ffdcbc] shrink-0">schedule</span>
            <span>Atención técnica y presencia continua en campo</span>
          </p>
        </div>
      </div>
    </div>

    <!-- Barra Inferior Legal -->
    <div class="mt-12 pt-8 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-[#dee4dc]/70">
      <p>© {new Date().getFullYear()} Soluciones y Desarrollos Agrícolas. Todos los derechos reservados.</p>
      <div class="flex flex-wrap items-center gap-6">
        <a href="/aviso-legal" class="hover:text-white transition-colors">Aviso Legal</a>
        <a href="/politicas-privacidad" class="hover:text-white transition-colors">Política de Privacidad</a>
        <a href="/politicas-cookies" class="hover:text-white transition-colors">Política de Cookies</a>
      </div>
    </div>
  </div>
</footer>