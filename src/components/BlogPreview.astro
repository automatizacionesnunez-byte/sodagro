---
const posts = [
  { title: "[Título del artículo]", date: "[Fecha]", href: "[URL]" },
];
---

<section id="blog" class="py-16 md:py-24">
  <div class="mx-auto max-w-[var(--max-width)] px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-[var(--font-display)] text-3xl font-bold tracking-tight text-[var(--color-text)]">
        Blog
      </h2>
      <p class="mt-4 text-lg text-[var(--color-text-muted)]">
        Ideas, análisis y mejores prácticas.
      </p>
    </div>
    <div class="mt-12 space-y-8">
      {posts.map((post) => (
        <article class="flex flex-col gap-2 border-b border-[var(--color-border)] pb-8 last:border-0">
          <a href={post.href} class="text-lg font-medium text-[var(--color-text)] hover:text-[var(--color-primary)]">
            {post.title}
          </a>
          <time class="text-sm text-[var(--color-text-muted)]" datetime={post.date}>{post.date}</time>
        </article>
      ))}
    </div>
  </div>
</section>