---
const features = [
  {
    title: "[Título del beneficio 1]",
    description: "[Descripción del beneficio]",
    icon: "[Icono]",
    image: "/images/feature-1.webp",
  },
  {
    title: "[Título del beneficio 2]",
    description: "[Descripción del beneficio]",
    icon: "[Icono]",
    image: "/images/feature-2.webp",
  },
  {
    title: "[Título del beneficio 3]",
    description: "[Descripción del beneficio]",
    icon: "[Icono]",
    image: "/images/feature-3.webp",
  },
];
---

<section id="servicios" class="py-16 md:py-24">
  <div class="mx-auto max-w-[var(--max-width)] px-6">
    <div class="mx-auto max-w-2xl">
      <h2 class="font-[var(--font-display)] text-3xl font-bold tracking-tight text-[var(--color-text)] sm:text-4xl">
        Lo que hacemos
      </h2>
      <p class="mt-4 text-lg text-[var(--color-text-muted)]">
        Servicios diseñados para resultados concretos.
      </p>
    </div>
    <div class="bento-grid mt-16">
      {features.map((feature, index) => {
        const spans = [
          "col-span-12 md:col-span-7 md:row-span-2",
          "col-span-12 md:col-span-5",
          "col-span-12 md:col-span-5",
        ];
        return (
          <article
            class={`${spans[index]} spotlight-card rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-8 transition-all`}
          >
            <img
              src={feature.image}
              alt=""
              width="1200"
              height="900"
              loading="lazy"
              decoding="async"
              class="mb-6 aspect-[4/3] w-full rounded-xl object-cover"
            />
            <div class="mb-4 text-3xl" aria-hidden="true">{feature.icon}</div>
            <h3 class="font-[var(--font-display)] text-xl font-bold text-[var(--color-text)]">
              {feature.title}
            </h3>
            <p class="mt-3 text-[var(--color-text-muted)]">
              {feature.description}
            </p>
          </article>
        );
      })}
    </div>
  </div>
</section>
