{
  "name": "sodagro-corporate-web",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint scripts",
    "typecheck": "astro check",
    "format": "prettier --write .",
    "test": "node --test tests/unit/smoke.test.mjs",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --grep @visual",
    "lighthouse": "npx --yes @lhci/cli@latest autorun",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "assets:download": "node scripts/download-assets.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e && npm run test:a11y"
  },
  "dependencies": {
    "astro": "^7.1.6",
    "@astrojs/sitemap": "^3.7.3",
    "tailwindcss": "^4.2.2",
    "@tailwindcss/vite": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.7.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "@playwright/test": "^1.50.0",
    "@axe-core/playwright": "^4.10.0"
  },
  "overrides": {
    "sharp": "^0.35.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm>=10.0.0"
}
